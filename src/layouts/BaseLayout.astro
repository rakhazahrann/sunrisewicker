---
import { ChevronUp, Mail, Phone } from '@lucide/astro';
import { content, pathFor, type Lang, type Page } from '../data/ui';
interface Props { lang: Lang; page: Page; title: string; description: string; canonicalPath?: string; alternatePath?: string; }
const { lang, page, title, description, canonicalPath = pathFor(lang, page), alternatePath = pathFor(lang === 'en' ? 'id' : 'en', page) } = Astro.props;
const t = content[lang];
const alternate = lang === 'en' ? 'id' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="synthetic wicker, synthetic rattan, outdoor furniture, PE wicker" />
    <link rel="icon" type="image/png" href="/images/logo/sunrise-logo.png" />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang={alternate} href={alternatePath} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/products/Imange/20200605_133616 banana leaf.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={`page-${page}`}>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Lewati ke konten'}</a>
    <header class="site-header" data-header>
      <a class="brand" href={pathFor(lang, 'home')} aria-label={lang === 'en' ? 'SUNRISE home' : 'Beranda SUNRISE'}>
        <img src="/images/logo/sunrise-logo.png" alt="SUNRISE" />
      </a>
      <nav id="main-navigation" data-nav aria-label={lang === 'en' ? 'Main navigation' : 'Navigasi utama'}>
        {(['home','about','products','contact'] as Page[]).map((item) => <a class:list={{ active: page === item }} aria-current={page === item ? 'page' : undefined} href={pathFor(lang, item)}>{t.nav[item]}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language" href={alternatePath} aria-label={`Switch to ${alternate === 'en' ? 'English' : 'Bahasa Indonesia'}`}>{alternate.toUpperCase()}</a>
      </div>
      <button class="menu-button" data-menu aria-label={lang === 'en' ? 'Open navigation' : 'Buka navigasi'} aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </header>
    <main id="main"><slot /></main>
    <div class="whatsapp-widget" data-wa-widget>
      <div class="wa-popup" data-wa-popup aria-hidden="true">
        <div class="wa-popup-header">
          <img class="wa-logo" src="/images/logo/sunrise-logo.png" alt="SUNRISE" />
          <div class="wa-header-text">
            <strong>SUNRISE Wicker</strong>
            <p>{lang === 'en' ? 'Chat with our sales team' : 'Hubungi tim sales kami'}</p>
          </div>
        </div>
        <div class="wa-popup-body">
          <a href="https://wa.me/62811308731" target="_blank" rel="noopener" class="wa-option">
            <div class="wa-option-icon">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </div>
