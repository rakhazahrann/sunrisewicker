---
import { ArrowUpRight, ChevronUp, MapPin } from '@lucide/astro';
import { content, pathFor, type Lang, type Page } from '../data/ui';
interface Props { lang: Lang; page: Page; title: string; description: string; canonicalPath?: string; alternatePath?: string; }
const { lang, page, title, description, canonicalPath = pathFor(lang, page), alternatePath = pathFor(lang === 'en' ? 'id' : 'en', page) } = Astro.props;
const t = content[lang];
const alternate = lang === 'en' ? 'id' : 'en';
const address = 'Kawasan Industri Dan Pergudangan SIRIE Blok S-12, Jl. Lingkar Timur KM 5, Rangkah Kidul, Sidoarjo, Jawa Timur';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="synthetic wicker, synthetic rattan, outdoor furniture, PE wicker" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang={alternate} href={alternatePath} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/products/Imange/20200605_133616 banana leaf.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={`page-${page}`}>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Lewati ke konten'}</a>
    <header class="site-header" data-header>
      <a class="brand" href={pathFor(lang, 'home')} aria-label={lang === 'en' ? 'SUNRISE home' : 'Beranda SUNRISE'}>
        <img src="/images/logo/sunrise-logo.png" alt="SUNRISE" />
      </a>
      <nav id="main-navigation" data-nav aria-label={lang === 'en' ? 'Main navigation' : 'Navigasi utama'}>
        {(['home','about','products','contact'] as Page[]).map((item) => <a class:list={{ active: page === item }} aria-current={page === item ? 'page' : undefined} href={pathFor(lang, item)}>{t.nav[item]}</a>)}
        <a class="mobile-sample" href={`${pathFor(lang, 'contact')}#main`}>{t.requestSample} <ArrowUpRight size={15} stroke-width={1.8} /></a>
      </nav>
      <div class="header-actions">
        <a class="language" href={alternatePath} aria-label={`Switch to ${alternate === 'en' ? 'English' : 'Bahasa Indonesia'}`}>{alternate.toUpperCase()}</a>
        <a class="sample-link" href={`${pathFor(lang, 'contact')}#main`}>{t.requestSample} <ArrowUpRight size={15} stroke-width={1.8} /></a>
      </div>
      <button class="menu-button" data-menu aria-label={lang === 'en' ? 'Open navigation' : 'Buka navigasi'} aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-mark" aria-hidden="true">SUNRISE</div>
      <div class="footer-grid">
        <div><p class="eyebrow">PT. Karya Mandiri Indoplast</p><p>{t.footer}</p></div>
        <nav aria-label={lang === 'en' ? 'Footer navigation' : 'Navigasi footer'}>{(['about','products','contact'] as Page[]).map((item) => <a href={pathFor(lang,item)}>{t.nav[item]}</a>)}</nav>
        <div class="footer-contact">
          <a href="https://wa.me/6281130939">+62 811 30939</a>
          <a href="mailto:sunrisewicker@gmail.com">sunrisewicker@gmail.com</a>
          <a href={mapsUrl} target="_blank" rel="noopener"><MapPin size={13} /> Sidoarjo, East Java</a>
          <a href="/SUNRISE COMPRO.pdf">{lang === 'en' ? 'Company profile ↗' : 'Profil perusahaan ↗'}</a>
        </div>
      </div>
      <div class="footer-base">
        <small>© {new Date().getFullYear()} SUNRISE</small>
        <small>Sidoarjo, East Java / Indonesia</small>
        <button class="back-to-top" data-top aria-label={t.backToTop}><ChevronUp size={18} /> {t.backToTop}</button>
      </div>
    </footer>
    <script>
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // ── Mobile menu ──
      const button = document.querySelector('[data-menu]');
      const nav = document.querySelector('[data-nav]');
      const closeMenu = () => {
        button?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        document.body.classList.remove('menu-open');
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
        document.body.classList.toggle('menu-open', !open);
      });
      addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

      // ── GSAP animations — guarded against missing elements ──
      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        const introEls = document.querySelectorAll('[data-intro]');
        const heroMedia = document.querySelectorAll('[data-hero-media]');
        const heroDetail = document.querySelectorAll('[data-hero-detail]');

        if (introEls.length || heroMedia.length || heroDetail.length) {
          const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
          if (introEls.length) intro.from(introEls, { yPercent: 110, duration: 1.05, stagger: .1 });
          if (heroMedia.length) intro.from(heroMedia, { clipPath: 'inset(0 0 100% 0)', duration: 1.15 }, .15);
          if (heroDetail.length) intro.from(heroDetail, { autoAlpha: 0, y: 18, duration: .65, stagger: .08 }, .55);
        }

        const revealEls = gsap.utils.toArray<Element>('[data-reveal]');
        revealEls.forEach((item) => gsap.from(item, {
          y: 48, autoAlpha: 0, duration: .9, ease: 'power2.out',
          scrollTrigger: { trigger: item, start: 'top 88%', once: true },
        }));
      });

      // ── Header hide-on-scroll ──
      let previous = scrollY;
      addEventListener('scroll', () => {
        const header = document.querySelector('[data-header]');
        header?.classList.toggle('compact', scrollY > 24);
        header?.classList.toggle('hidden', scrollY > previous && scrollY > 180);
        previous = scrollY;
      }, { passive: true });

      // ── Back to top ──
      document.querySelector('[data-top]')?.addEventListener('click', () => {
        scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #081a2c;
    --blue: #102f4b;
    --orange: #a8793d;
    --yellow: #d8bd88;
    --gold: var(--orange);
    --gold-light: var(--yellow);
    --gold-dark: #785025;
    --paper: #f4f1e9;
    --white: #fffdf8;
    --muted: #62686b;
    --line: rgba(8,26,44,.16);
    --max: 1440px;
    --pad: max(24px, calc((100vw - var(--max)) / 2));
    --display: 'Poppins', sans-serif;
    --body: 'Poppins', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
    --radius-sm: 12px;
    --radius: 22px;
    --radius-lg: 36px;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--body);
    font-synthesis: none;
  }
  * { box-sizing: border-box }
  html { scroll-behavior: smooth }
  body { margin: 0; overflow-x: hidden; background: var(--paper) }
  a { color: inherit; text-decoration: none }
  img { display: block; max-width: 100% }
  button, input, select, textarea { font: inherit }
  :focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px }
  .skip { position: fixed; z-index: 100; top: -5rem; left: 1rem; padding: .8rem 1rem; background: var(--yellow) }
  .skip:focus { top: 1rem }
  .site-header {
    position: fixed; z-index: 30; top: 0; left: 0; right: 0; height: 88px;
    display: grid; grid-template-columns: 220px 1fr auto; align-items: center;
    padding: 0 var(--pad); color: white; border-bottom: 1px solid rgba(255,255,255,.22);
    transition: transform .4s, height .3s, background .3s, color .3s;
  }
  .site-header.compact { height: 70px; color: var(--ink); background: rgba(243,241,233,.96); border-color: var(--line); backdrop-filter: blur(16px) }
  .site-header.hidden { transform: translateY(-105%) }
  .brand { width: 62px; height: 62px; display: grid; place-items: center; padding: 3px; overflow: hidden; background: white; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; box-shadow: 0 8px 24px rgba(8,26,44,.12) }
  .brand img { width: 100%; height: 100%; max-height: none; object-fit: contain; border-radius: 50% }
  .site-header nav { justify-self: center; display: flex; align-items: center; gap: clamp(1.5rem,3vw,3.5rem) }
  .site-header nav a { position: relative; font: 500 .72rem var(--mono); letter-spacing: .08em; text-transform: uppercase }
  .site-header nav a::before { content: ''; position: absolute; left: 0; right: 100%; bottom: -.55rem; height: 1px; background: var(--yellow); transition: right .25s }
  .site-header nav a:hover::before, .site-header nav a.active::before { right: 0 }
  .header-actions { display: flex; align-items: center; gap: .7rem }
  .language { display: grid; width: 44px; height: 44px; place-items: center; font: 500 .68rem var(--mono); border: 1px solid currentColor; border-radius: 999px; transition: color .25s, background .25s }
  .language:hover { color: var(--ink); background: var(--yellow) }
  .sample-link { display: inline-flex; min-height: 44px; padding: .72rem 1.15rem; align-items: center; gap: .7rem; color: white; background: rgba(8,26,44,.38); border: 1px solid rgba(255,255,255,.6); border-radius: 999px; font-size: .76rem; font-weight: 500; letter-spacing: .04em; transition: color .25s, background .25s }
  .compact .sample-link { color: var(--ink); background: transparent; border-color: var(--ink) }
  .mobile-sample { display: none !important }
  .menu-button { display: none }
  .eyebrow { margin: 0 0 1.1rem; color: var(--orange); font: 500 .66rem var(--mono); letter-spacing: .16em; text-transform: uppercase }
  .display, .section-title { margin: 0; font-family: var(--display); font-weight: 600; letter-spacing: -.025em }
  .display { font-size: clamp(4rem,8vw,8rem); line-height: .84 }
  .section-title { font-size: clamp(3rem,5.7vw,5.8rem); line-height: .92 }
  .lede { max-width: 650px; color: var(--muted); font-size: clamp(1rem,1.4vw,1.2rem); line-height: 1.7 }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: .8rem 1.4rem; border: 1px solid var(--ink); border-radius: 999px; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; transition: color .25s, background .25s, border-color .25s, transform .25s }
  .button:hover { transform: translateY(-2px) }
  .button:hover, .button.primary { color: white; background: var(--ink) }
  .button.primary:hover { color: var(--ink); background: var(--yellow); border-color: var(--yellow) }
  .text-link { display: inline-flex; align-items: center; gap: .4rem; padding-bottom: .35rem; border-bottom: 1px solid var(--orange); font-size: .8rem; font-weight: 600 }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap }
  footer { position: relative; isolation: isolate; min-height: 620px; padding: clamp(7rem,11vw,11rem) var(--pad) 2rem; color: white; background: var(--ink); overflow: hidden }
  .footer-mark { position: absolute; z-index: -1; left: 50%; top: 49%; width: 100%; color: rgba(216,189,136,.075); font: 600 clamp(10rem,25vw,24rem)/.7 var(--display); letter-spacing: -.065em; text-align: center; transform: translate(-50%,-50%); user-select: none; white-space: nowrap }
  .footer-grid { display: grid; grid-template-columns: 1fr .45fr .7fr; gap: 4rem; padding: 0 0 clamp(6rem,10vw,10rem); border-bottom: 1px solid rgba(255,255,255,.2) }
  .footer-grid p:not(.eyebrow) { max-width: 410px; color: #aab5bf; line-height: 1.6 }
  .footer-grid nav, .footer-contact { display: grid; align-content: start; gap: 1rem }
  .footer-grid a { width: fit-content; display: inline-flex; align-items: center; gap: .4rem; border-bottom: 1px solid transparent; font-size: .85rem }
  .footer-grid a:hover { border-color: var(--orange) }
  .footer-base { display: flex; justify-content: space-between; align-items: center; padding-top: 1.5rem; color: #a3aeb8; font: .65rem var(--mono); text-transform: uppercase }
  .back-to-top { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem .9rem; color: #a3aeb8; background: transparent; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; cursor: pointer; font: .65rem var(--mono); text-transform: uppercase; transition: color .25s, border-color .25s, background .25s }
  .back-to-top:hover { color: var(--yellow); border-color: var(--yellow) }
  @media (max-width: 800px) {
    :root { --pad: 18px }
    .site-header { height: 70px; grid-template-columns: 1fr auto auto; gap: .7rem }
    .brand { width: 50px; height: 50px }
    .sample-link { display: none }
    .mobile-sample { display: flex !important; justify-content: center; align-items: center; gap: .5rem; width: 100%; margin-top: .5rem; padding: 1rem; color: white !important; background: var(--ink) !important; border: none !important; border-radius: 14px !important; font: 600 .85rem var(--display) !important; text-transform: uppercase; letter-spacing: .04em }
    .menu-button { display: grid; width: 42px; height: 42px; padding: 0; place-content: center; gap: 6px; color: inherit; background: transparent; border: 1px solid currentColor; border-radius: 50% }
    .menu-button span { display: block; width: 20px; height: 1px; background: currentColor; transition: transform .25s }
    .menu-button[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg) }
    .menu-button[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg) }
    .site-header nav { display: none; position: absolute; top: 70px; left: 0; right: 0; padding: 2rem 18px 3rem; align-items: flex-start; gap: 0; flex-direction: column; color: var(--ink); background: var(--paper); border-bottom: 1px solid var(--line) }
    .site-header nav.open { display: flex }
    .site-header nav a { width: 100%; padding: 1rem 0; border-bottom: 1px solid var(--line); font: 600 2rem var(--display) }
    .site-header nav a::before { display: none }
    .display { font-size: clamp(4rem,22vw,7rem) }
    footer { min-height: 760px; padding-top: 6rem }
    .footer-mark { top: 52%; font-size: 35vw; writing-mode: vertical-rl; width: auto }
    .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; padding-bottom: 5rem }
    .footer-base { gap: 1rem; flex-direction: column; align-items: flex-start }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important }
  }
</style>
