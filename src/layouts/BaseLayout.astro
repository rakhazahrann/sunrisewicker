---
import { ChevronUp, Mail, Phone } from '@lucide/astro';
import { content, pathFor, type Lang, type Page } from '../data/ui';
interface Props { lang: Lang; page: Page; title: string; description: string; canonicalPath?: string; alternatePath?: string; }
const { lang, page, title, description, canonicalPath = pathFor(lang, page), alternatePath = pathFor(lang === 'en' ? 'id' : 'en', page) } = Astro.props;
const t = content[lang];
const alternate = lang === 'en' ? 'id' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="synthetic wicker, synthetic rattan, outdoor furniture, PE wicker" />
    <link rel="icon" type="image/png" href="/images/logo/sunrise-logo.png" />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang={alternate} href={alternatePath} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/products/Imange/20200605_133616 banana leaf.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={`page-${page}`}>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Lewati ke konten'}</a>
    <header class="site-header" data-header>
      <a class="brand" href={pathFor(lang, 'home')} aria-label={lang === 'en' ? 'SUNRISE home' : 'Beranda SUNRISE'}>
        <img src="/images/logo/sunrise-logo.png" alt="SUNRISE" />
      </a>
      <nav id="main-navigation" data-nav aria-label={lang === 'en' ? 'Main navigation' : 'Navigasi utama'}>
        {(['home','about','products','contact'] as Page[]).map((item) => <a class:list={{ active: page === item }} aria-current={page === item ? 'page' : undefined} href={pathFor(lang, item)}>{t.nav[item]}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language" href={alternatePath} aria-label={`Switch to ${alternate === 'en' ? 'English' : 'Bahasa Indonesia'}`}>{alternate.toUpperCase()}</a>
      </div>
      <button class="menu-button" data-menu aria-label={lang === 'en' ? 'Open navigation' : 'Buka navigasi'} aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={pathFor(lang, 'home')} aria-label={lang === 'en' ? 'SUNRISE home' : 'Beranda SUNRISE'}><img src="/images/logo/sunrise-logo.png" alt="SUNRISE Synthetic Wicker" /></a>
            <p>{t.footer}</p>
          </div>
          <nav class="footer-nav" aria-label={lang === 'en' ? 'Footer navigation' : 'Navigasi footer'}>
            <strong>{lang === 'en' ? 'Company' : 'Perusahaan'}</strong>
            {(['about','products','contact'] as Page[]).map((item) => <a href={pathFor(lang,item)}>{t.nav[item]}</a>)}
          </nav>
          <div class="footer-contact">
            <strong>{lang === 'en' ? 'Contact info' : 'Informasi kontak'}</strong>
            <a href="https://wa.me/62811308731"><Phone size={14} /> +62 811 308 731</a>
            <a href="https://wa.me/62811327030"><Phone size={14} /> +62 811 327 030</a>
            <a href="mailto:sunrisewicker@gmail.com"><Mail size={14} /> sunrisewicker@gmail.com</a>
          </div>
          <div class="footer-social">
            <strong>{lang === 'en' ? 'Connect with us' : 'Terhubung dengan kami'}</strong>
            <p>{lang === 'en' ? 'Discuss products, specifications, and samples with our team.' : 'Diskusikan produk, spesifikasi, dan sampel bersama tim kami.'}</p>
            <div class="social-links">
              <a href="https://www.instagram.com/sunrisewicker/" target="_blank" rel="noopener" aria-label="Instagram SUNRISEWICKER"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="18" height="18" x="3" y="3" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
              <a href="https://wa.me/62811327030" aria-label="WhatsApp SUNRISE"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.4-4.3a8.5 8.5 0 1 1 15.6-4.6Z"/><path d="M8.4 7.9c.2-.4.4-.4.7-.4h.5c.2 0 .3.1.4.4l.8 1.8c.1.2 0 .4-.1.6l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.2 2.9 2.8.2.1.4.1.6-.1l.8-.9c.2-.2.4-.3.6-.2l1.8.8c.3.1.4.3.4.5 0 .7-.5 1.5-1 1.9-.6.5-1.4.7-2.3.4-1.4-.4-2.8-1.2-4-2.3-1.4-1.3-2.4-2.9-2.8-4-.3-1 0-1.9.5-2.4.2-.1.5-.2.8-.2Z"/></svg></a>
            </div>
          </div>
        </div>
        <div class="footer-base">
          <small>© {new Date().getFullYear()} SUNRISE™. {lang === 'en' ? 'All rights reserved.' : 'Seluruh hak cipta dilindungi.'}</small>
          <small>PT. Karya Mandiri Indoplast / Indonesia</small>
          <button class="back-to-top" data-top aria-label={t.backToTop}>{t.backToTop} <ChevronUp size={15} /></button>
        </div>
      </div>
    </footer>
    <script>
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // ── Mobile menu ──
      const button = document.querySelector('[data-menu]');
      const nav = document.querySelector('[data-nav]');
      const closeMenu = () => {
        button?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        document.body.classList.remove('menu-open');
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
        document.body.classList.toggle('menu-open', !open);
      });
      addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

      // ── GSAP animations — guarded against missing elements ──
      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        const introEls = document.querySelectorAll('[data-intro]');
        const heroMedia = document.querySelectorAll('[data-hero-media]');
        const heroDetail = document.querySelectorAll('[data-hero-detail]');

        if (introEls.length || heroMedia.length || heroDetail.length) {
          const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
          if (introEls.length) intro.from(introEls, { yPercent: 110, duration: 1.05, stagger: .1 });
          if (heroMedia.length) intro.from(heroMedia, { clipPath: 'inset(0 0 100% 0)', duration: 1.15 }, .15);
          if (heroDetail.length) intro.from(heroDetail, { autoAlpha: 0, y: 18, duration: .65, stagger: .08 }, .55);
        }

        const revealEls = gsap.utils.toArray<Element>('[data-reveal]');
        revealEls.forEach((item) => gsap.from(item, {
          y: 48, autoAlpha: 0, duration: .9, ease: 'power2.out',
          scrollTrigger: { trigger: item, start: 'top 88%', once: true },
        }));
      });

      // ── Header hide-on-scroll ──
      let previous = scrollY;
      addEventListener('scroll', () => {
        const header = document.querySelector('[data-header]');
        header?.classList.toggle('compact', scrollY > 24);
        const hidden = scrollY > previous && scrollY > 180;
        header?.classList.toggle('hidden', hidden);
        document.body.classList.toggle('header-hidden', hidden);
        previous = scrollY;
      }, { passive: true });

      // ── Back to top ──
      document.querySelector('[data-top]')?.addEventListener('click', () => {
        scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #081a2c;
    --blue: #102f4b;
    --orange: #a8793d;
    --yellow: #d8bd88;
    --gold: var(--orange);
    --gold-light: var(--yellow);
    --gold-dark: #785025;
    --paper: #f4f1e9;
    --white: #fffdf8;
    --muted: #62686b;
    --line: rgba(8,26,44,.16);
    --max: 1440px;
    --pad: max(24px, calc((100vw - var(--max)) / 2));
    --display: 'Poppins', sans-serif;
    --body: 'Poppins', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
    --radius-sm: 12px;
    --radius: 22px;
    --radius-lg: 36px;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--body);
    font-synthesis: none;
  }
  * { box-sizing: border-box }
  html { scroll-behavior: smooth }
  body { margin: 0; overflow-x: clip; background: var(--paper) }
  a { color: inherit; text-decoration: none }
  img { display: block; max-width: 100% }
  button, input, select, textarea { font: inherit }
  :focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px }
  .skip { position: fixed; z-index: 100; top: -5rem; left: 1rem; padding: .8rem 1rem; background: var(--yellow) }
  .skip:focus { top: 1rem }
  .site-header {
    position: fixed; z-index: 30; top: 0; left: 0; right: 0; height: 88px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 var(--pad); color: white; border-bottom: 1px solid rgba(255,255,255,.22);
    transition: transform .4s, height .3s, background .3s, color .3s;
  }
  .site-header.compact { height: 70px; color: var(--ink); background: rgba(243,241,233,.96); border-color: var(--line); backdrop-filter: blur(16px) }
  .site-header.hidden { transform: translateY(-105%) }
  .brand { width: 62px; height: 62px; display: grid; place-items: center; padding: 3px; overflow: hidden; background: white; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; box-shadow: 0 8px 24px rgba(8,26,44,.12) }
  .brand img { width: 100%; height: 100%; max-height: none; object-fit: contain; border-radius: 50% }
  .site-header nav { justify-self: center; display: flex; align-items: center; gap: clamp(1.5rem,3vw,3.5rem) }
  .site-header nav a { position: relative; font: 600 .76rem var(--body); letter-spacing: .08em; text-transform: uppercase }
  .site-header nav a::before { content: ''; position: absolute; left: 0; right: 100%; bottom: -.55rem; height: 1px; background: var(--yellow); transition: right .25s }
  .site-header nav a:hover::before, .site-header nav a.active::before { right: 0 }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: .7rem }
  .language { display: grid; width: 44px; height: 44px; place-items: center; font: 600 .72rem var(--body); border: 1px solid currentColor; border-radius: 999px; transition: color .25s, background .25s }
  .language:hover { color: var(--ink); background: var(--yellow) }
  .menu-button { display: none }
  .eyebrow { margin: 0 0 1.1rem; color: var(--orange); font: 500 .66rem var(--mono); letter-spacing: .16em; text-transform: uppercase }
  .display, .section-title { margin: 0; font-family: var(--display); font-weight: 600; letter-spacing: -.025em }
  .display { font-size: clamp(4rem,8vw,8rem); line-height: .84 }
  .section-title { font-size: clamp(3rem,5.7vw,5.8rem); line-height: .92 }
  .lede { max-width: 650px; color: var(--muted); font-size: clamp(1rem,1.4vw,1.2rem); line-height: 1.7 }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: .8rem 1.4rem; border: 1px solid var(--ink); border-radius: 999px; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; transition: color .25s, background .25s, border-color .25s, transform .25s }
  .button:hover { transform: translateY(-2px) }
  .button:hover, .button.primary { color: white; background: var(--ink) }
  .button.primary:hover { color: var(--ink); background: var(--yellow); border-color: var(--yellow) }
  .text-link { display: inline-flex; align-items: center; gap: .4rem; padding-bottom: .35rem; border-bottom: 1px solid var(--orange); font-size: .8rem; font-weight: 600 }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap }
  footer { color: white; background: #081d30 }
  .footer-shell { overflow: hidden; background: #081d30 }
  .footer-grid { display: grid; grid-template-columns: 1.2fr .65fr 1.2fr .9fr; gap: clamp(2.5rem,5vw,6rem); max-width: var(--max); margin: 0 auto; padding: clamp(4.5rem,7vw,7rem) clamp(24px,4vw,48px) }
  .footer-brand { padding-right: clamp(1.5rem,4vw,4rem); border-right: 1px solid rgba(216,189,136,.42) }
  .footer-brand a { display: block; width: min(175px,100%); padding: .55rem; background: #fff; border-radius: 10px }
  .footer-brand img { width: 100%; max-height: 82px; object-fit: contain }
  .footer-brand p, .footer-social p { max-width: 310px; margin: 1.35rem 0 0; color: #b9c4cf; font-size: .78rem; line-height: 1.7 }
  .footer-social p { margin: 0 }
  .footer-grid strong { margin-bottom: .55rem; color: #fff; font-size: .82rem; font-weight: 600 }
  .footer-nav, .footer-contact, .footer-social { display: grid; align-content: start; gap: .85rem }
  .footer-grid a:not(.footer-brand a) { width: fit-content; display: inline-flex; align-items: center; gap: .55rem; color: #d4dce3; border-bottom: 1px solid transparent; font-size: .75rem; transition: color .25s,border-color .25s }
  .footer-grid a:hover { color: var(--yellow); border-color: var(--orange) }
  .social-links { display: flex; gap: .65rem; margin-top: .5rem }
  .footer-grid .footer-social .social-links a { width: 44px; min-width: 44px; height: 44px; flex: 0 0 44px; display: grid; place-items: center; color: #d4dce3; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.12); border-radius: 50%; transition: color .25s, background .25s, border-color .25s, transform .25s }
  .footer-grid .social-links a:hover { color: white; background: rgba(216,189,136,.16); border-color: var(--yellow); transform: translateY(-2px) }
  .footer-base { min-height: 68px; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; max-width: var(--max); margin: 0 auto; padding: 1rem clamp(24px,4vw,48px); color: #91a0ae; border-top: 1px solid var(--orange); font: .6rem var(--mono); letter-spacing: .03em; text-transform: uppercase }
  .footer-base small:nth-child(2) { justify-self: center }
  .back-to-top { justify-self: end; display: inline-flex; align-items: center; gap: .4rem; padding: .5rem 0; color: #a3aeb8; background: transparent; border: 0; cursor: pointer; font: .6rem var(--mono); text-transform: uppercase; transition: color .25s }
  .back-to-top:hover { color: var(--yellow) }
  @media (max-width: 1000px) {
    .footer-grid { grid-template-columns: 1fr 1fr }
    .footer-brand, .footer-contact { grid-column: 1 / -1 }
    .footer-contact a { overflow-wrap: anywhere }
  }
  @media (max-width: 800px) {
    :root { --pad: 18px }
    .site-header { height: 70px; grid-template-columns: 1fr auto auto; gap: .7rem }
    .brand { width: 50px; height: 50px }
    .menu-button { display: grid; width: 42px; height: 42px; padding: 0; place-content: center; gap: 6px; color: inherit; background: transparent; border: 1px solid currentColor; border-radius: 50% }
    .menu-button span { display: block; width: 20px; height: 1px; background: currentColor; transition: transform .25s }
    .menu-button[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg) }
    .menu-button[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg) }
    body.menu-open { overflow: hidden; scrollbar-width: none }
    body.menu-open::-webkit-scrollbar { display: none }
    .site-header:has(nav.open) { transform: none }
    .site-header nav { position: fixed; top: 70px; left: 0; right: 0; width: 100%; max-height: 0; overflow: hidden; padding: 0 18px; align-items: flex-start; justify-self: stretch; gap: 0; flex-direction: column; color: var(--ink); background: var(--paper); border-bottom: 1px solid transparent; transition: max-height .35s cubic-bezier(.4,0,.2,1), padding .35s cubic-bezier(.4,0,.2,1), border-color .25s; display: flex; z-index: 29 }
    .site-header nav.open { max-height: calc(100dvh - 70px); overflow-y: auto; padding: 2rem 18px 3rem; border-bottom: 1px solid var(--line) }
    .site-header nav a { width: 100%; padding: 1rem 0; border-bottom: 1px solid var(--line); font: 600 2rem var(--display); opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s }
    .site-header nav.open a { opacity: 1; transform: translateY(0) }
    .site-header nav a::before { display: none }
    .display { font-size: clamp(2.75rem,16vw,7rem); overflow-wrap: break-word }
    footer { padding: 0 }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; padding: 2rem 1.3rem }
    .footer-brand { grid-column: 1 / -1; padding: 0 0 2rem; border-right: 0; border-bottom: 1px solid rgba(216,189,136,.42) }
    .footer-brand a { width: 180px }
    .footer-contact { grid-column: 1 / -1 }
    .footer-base { grid-template-columns: 1fr auto; gap: .8rem; padding: 1.2rem 1.3rem }
    .footer-base small:nth-child(2) { display: none }
    .back-to-top { justify-self: end }
  }
  @media (max-width: 420px) {
    .display { font-size: clamp(2.2rem,13vw,4rem) }
    .footer-grid { gap: 2rem 1rem; padding: 1.8rem 1rem }
    .footer-base { padding: 1rem }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important }
  }
</style>
