              <span class="wa-label">{lang === 'en' ? 'Sales 2' : 'Sales 2'}</span>
              <strong class="wa-num">+62 811 327 030</strong>
            </div>
          </a>
        </div>
      </div>
      <button type="button" class="floating-whatsapp" data-wa-trigger aria-label={lang === 'en' ? 'Chat with SUNRISE on WhatsApp' : 'Chat dengan SUNRISE lewat WhatsApp'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      </button>
    </div>
    <footer>
      <div class="footer-shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={pathFor(lang, 'home')} aria-label={lang === 'en' ? 'SUNRISE home' : 'Beranda SUNRISE'}><img src="/images/logo/sunrise-logo.png" alt="SUNRISE Synthetic Wicker" /></a>
            <p>{t.footer.desc}<br />{t.footer.by}</p>
          </div>
          <nav class="footer-nav" aria-label={lang === 'en' ? 'Footer navigation' : 'Navigasi footer'}>
            <strong>{lang === 'en' ? 'Company' : 'Perusahaan'}</strong>
            {(['about','products','contact'] as Page[]).map((item) => <a href={pathFor(lang,item)}>{t.nav[item]}</a>)}
          </nav>
          <div class="footer-contact">
            <strong>{lang === 'en' ? 'Contact info' : 'Informasi kontak'}</strong>
            <a href="https://wa.me/62811308731"><Phone size={14} /> +62 811 308 731</a>
            <a href="https://wa.me/62811327030"><Phone size={14} /> +62 811 327 030</a>
            <a href="mailto:sunrisewicker@gmail.com"><Mail size={14} /> sunrisewicker@gmail.com</a>
          </div>
          <div class="footer-social">
            <strong>{lang === 'en' ? 'Connect with us' : 'Terhubung dengan kami'}</strong>
            <p>{lang === 'en' ? 'Discuss products, specifications, and samples with our team.' : 'Diskusikan produk, spesifikasi, dan sampel bersama tim kami.'}</p>
            <div class="social-links">
              <a href="https://www.instagram.com/sunrisewicker/" target="_blank" rel="noopener" aria-label="Instagram SUNRISEWICKER"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="18" height="18" x="3" y="3" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
              <a href="https://wa.me/62811327030" aria-label="WhatsApp SUNRISE"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
            </div>
          </div>
        </div>
        <div class="footer-base">
          <small>© {new Date().getFullYear()} SUNRISE™. {lang === 'en' ? 'All rights reserved.' : 'Seluruh hak cipta dilindungi.'}</small>
          <small>PT. Karya Mandiri Indoplast / Indonesia</small>
          <button class="back-to-top" data-top aria-label={t.backToTop}>{t.backToTop} <ChevronUp size={15} /></button>
        </div>
      </div>
    </footer>
    <script>
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // ── Mobile menu ──
      const button = document.querySelector('[data-menu]');
      const nav = document.querySelector('[data-nav]');
      const closeMenu = () => {
        button?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        document.body.classList.remove('menu-open');
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
        document.body.classList.toggle('menu-open', !open);
      });
      addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

      // ── GSAP animations — guarded against missing elements ──
      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        const introEls = document.querySelectorAll('[data-intro]');
        const heroMedia = document.querySelectorAll('[data-hero-media]');
        const heroDetail = document.querySelectorAll('[data-hero-detail]');

        if (introEls.length || heroMedia.length || heroDetail.length) {
          const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
          if (introEls.length) intro.from(introEls, { yPercent: 110, duration: 1.05, stagger: .1 });
          if (heroMedia.length) intro.from(heroMedia, { clipPath: 'inset(0 0 100% 0)', duration: 1.15 }, .15);
          if (heroDetail.length) intro.from(heroDetail, { autoAlpha: 0, y: 18, duration: .65, stagger: .08 }, .55);
        }

        const revealEls = gsap.utils.toArray<Element>('[data-reveal]');
        revealEls.forEach((item) => gsap.from(item, {
          y: 48, autoAlpha: 0, duration: .9, ease: 'power2.out',
          scrollTrigger: { trigger: item, start: 'top 88%', once: true },
        }));
      });

      // ── Header hide-on-scroll ──
      let previous = scrollY;
      addEventListener('scroll', () => {
        const header = document.querySelector('[data-header]');
        header?.classList.toggle('compact', scrollY > 24);
        const hidden = scrollY > previous && scrollY > 180;
        header?.classList.toggle('hidden', hidden);
        document.body.classList.toggle('header-hidden', hidden);
        previous = scrollY;
      }, { passive: true });

      // ── Back to top ──
      document.querySelector('[data-top]')?.addEventListener('click', () => {
        scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ── Floating WhatsApp widget ──
      const waWidget = document.querySelector('[data-wa-widget]');
      const waTrigger = document.querySelector('[data-wa-trigger]');
      const waPopup = document.querySelector('[data-wa-popup]');

      waTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = waPopup?.classList.contains('open');
        waPopup?.classList.toggle('open', !open);
        waPopup?.setAttribute('aria-hidden', String(open));
      });

      document.addEventListener('click', (e) => {
        if (waWidget && !waWidget.contains(e.target as Node)) {
          waPopup?.classList.remove('open');
          waPopup?.setAttribute('aria-hidden', 'true');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #081a2c;
    --blue: #102f4b;
    --orange: #a8793d;
    --yellow: #d8bd88;
    --gold: var(--orange);
    --gold-light: var(--yellow);
    --gold-dark: #785025;
    --paper: #f4f1e9;
    --white: #fffdf8;
    --muted: #62686b;
    --line: rgba(8,26,44,.16);
    --max: 1440px;
    --pad: max(24px, calc((100vw - var(--max)) / 2));
    --display: 'Poppins', sans-serif;
    --body: 'Poppins', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
    --radius-sm: 12px;
    --radius: 22px;
    --radius-lg: 36px;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--body);
    font-synthesis: none;
  }
  * { box-sizing: border-box }
  html { scroll-behavior: smooth }
  body { margin: 0; overflow-x: clip; background: var(--paper) }
  a { color: inherit; text-decoration: none }
  img { display: block; max-width: 100% }
  button, input, select, textarea { font: inherit }
  :focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px }
  .skip { position: fixed; z-index: 100; top: -5rem; left: 1rem; padding: .8rem 1rem; background: var(--yellow) }
  .skip:focus { top: 1rem }
  .site-header {
    position: fixed; z-index: 30; top: 0; left: 0; right: 0; height: 88px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 var(--pad); color: white; border-bottom: 1px solid rgba(255,255,255,.22);
    transition: transform .4s, height .3s, background .3s, color .3s;
  }
  .site-header.compact { height: 70px; color: var(--ink); background: rgba(243,241,233,.96); border-color: var(--line); backdrop-filter: blur(16px) }
  .site-header.hidden { transform: translateY(-105%) }
  .brand { width: 62px; height: 62px; display: grid; place-items: center; padding: 3px; overflow: hidden; background: white; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; box-shadow: 0 8px 24px rgba(8,26,44,.12) }
  .brand img { width: 100%; height: 100%; max-height: none; object-fit: contain; border-radius: 50% }
  .site-header nav { justify-self: center; display: flex; align-items: center; gap: clamp(1.5rem,3vw,3.5rem) }
  .site-header nav a { position: relative; font: 600 .76rem var(--body); letter-spacing: .08em; text-transform: uppercase }
  .site-header nav a::before { content: ''; position: absolute; left: 0; right: 100%; bottom: -.55rem; height: 1px; background: var(--yellow); transition: right .25s }
  .site-header nav a:hover::before, .site-header nav a.active::before { right: 0 }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: .7rem }
  .language { display: grid; width: 44px; height: 44px; place-items: center; font: 600 .72rem var(--body); border: 1px solid currentColor; border-radius: 999px; transition: color .25s, background .25s }
  .language:hover { color: var(--ink); background: var(--yellow) }
  .menu-button { display: none }
  .eyebrow { margin: 0 0 1.1rem; color: var(--orange); font: 500 .66rem var(--mono); letter-spacing: .16em; text-transform: uppercase }
  .display, .section-title { margin: 0; font-family: var(--display); font-weight: 600; letter-spacing: -.025em }
  .display { font-size: clamp(4rem,8vw,8rem); line-height: .84 }
  .section-title { font-size: clamp(3rem,5.7vw,5.8rem); line-height: .92 }
  .lede { max-width: 650px; color: var(--muted); font-size: clamp(1rem,1.4vw,1.2rem); line-height: 1.7 }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: .8rem 1.4rem; border: 1px solid var(--ink); border-radius: 999px; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; transition: color .25s, background .25s, border-color .25s, transform .25s }
  .button:hover { transform: translateY(-2px) }
  .button:hover, .button.primary { color: white; background: var(--ink) }
  .button.primary:hover { color: var(--ink); background: var(--yellow); border-color: var(--yellow) }
  .text-link { display: inline-flex; align-items: center; gap: .4rem; padding-bottom: .35rem; border-bottom: 1px solid var(--orange); font-size: .8rem; font-weight: 600 }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap }
  footer { color: white; background: #081d30 }
  .footer-shell { overflow: hidden; background: #081d30 }
  .footer-grid { display: grid; grid-template-columns: 1.2fr .65fr 1.2fr .9fr; gap: clamp(2.5rem,5vw,6rem); max-width: var(--max); margin: 0 auto; padding: clamp(4.5rem,7vw,7rem) clamp(24px,4vw,48px) }
  .footer-brand { padding-right: clamp(1.5rem,4vw,4rem); border-right: 1px solid rgba(216,189,136,.42) }
  .footer-brand a { display: block; width: min(175px,100%); padding: .55rem; background: #fff; border-radius: 10px }
  .footer-brand img { width: 100%; max-height: 82px; object-fit: contain }
  .footer-brand p, .footer-social p { max-width: 310px; margin: 1.35rem 0 0; color: #b9c4cf; font-size: .78rem; line-height: 1.7 }
  .footer-social p { margin: 0 }
  .footer-grid strong { margin-bottom: .55rem; color: #fff; font-size: .82rem; font-weight: 600 }
  .footer-nav, .footer-contact, .footer-social { display: grid; align-content: start; gap: .85rem }
  .footer-grid a:not(.footer-brand a) { width: fit-content; display: inline-flex; align-items: center; gap: .55rem; color: #d4dce3; border-bottom: 1px solid transparent; font-size: .75rem; transition: color .25s,border-color .25s }
  .footer-grid a:hover { color: var(--yellow); border-color: var(--orange) }
  .whatsapp-widget { position: fixed; right: clamp(1rem,2.5vw,2rem); bottom: clamp(1rem,2.5vw,2rem); z-index: 99 }
  .floating-whatsapp { display: grid; place-items: center; width: 74px; height: 48px; padding: 0; color: white; background: #25d366; border: none; border-radius: 9999px; box-shadow: 0 8px 22px rgba(0,0,0,.18); cursor: pointer; transition: background .2s ease, transform .2s ease, box-shadow .2s ease }
