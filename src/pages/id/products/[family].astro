---
import ProductFamilyPage from '../../../components/ProductFamilyPage.astro';
import { families } from '../../../data/products';
export function getStaticPaths() { return families.map((family) => ({ params: { family: family.slug }, props: { family } })); }
const { family } = Astro.props;
---
<ProductFamilyPage lang="id" family={family} />
