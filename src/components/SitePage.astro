---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from './ContactBlock.astro';
import { ArrowDown, ArrowUpRight, CloudRain, Recycle, Snowflake, Sun, Send, Thermometer } from '@lucide/astro';
import { content, pathFor, type Lang, type Page } from '../data/ui';
import { families, familyPath, products } from '../data/products';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const t = content[lang];
const titles = { home: lang === 'en' ? 'SUNRISE | High Quality Synthetic Wicker' : 'SUNRISE | Rotan Sintetis Berkualitas Tinggi', about: `${t.nav.about} | SUNRISE`, products: `${t.nav.products} | SUNRISE`, contact: `${t.nav.contact} | SUNRISE` };
const whatsapp = `https://wa.me/62811327030?text=${encodeURIComponent(lang === 'en' ? 'Hello SUNRISE, I would like to ask about your synthetic wicker products.' : 'Halo SUNRISE, saya ingin bertanya tentang produk rotan sintetis.')}`;
const whatsappAlt = `https://wa.me/62811308731?text=${encodeURIComponent(lang === 'en' ? 'Hello SUNRISE, I would like to ask about your synthetic wicker products.' : 'Halo SUNRISE, saya ingin bertanya tentang produk rotan sintetis.')}`;
const benefitIcons = [Sun, Snowflake, Recycle, Thermometer, CloudRain];
const surfaceOptions = [
  ['RR', 'Regular Ribbed', 'Garis rusuk reguler'],
  ['FR', 'Fine Ribbed', 'Garis rusuk halus'],
  ['IRR', 'Irregular Ribbed', 'Garis rusuk tidak beraturan'],
  ['TX', 'Textured', 'Permukaan bertekstur'],
  ['SM', 'Smooth', 'Permukaan halus'],
  ['HL', 'Hair Line / Brushed', 'Motif garis seperti disikat'],
  ['EBS', 'Embossed', 'Permukaan berpola timbul'],
] as const;
---
<BaseLayout lang={lang} page={page} title={titles[page]} description={t.about.text}>
  {page === 'home' && <>
    <section class="home-hero">
      <div class="hero-media" data-hero-media><img src="/images/editorial/compro-outdoor-dining.jpg" alt="SUNRISE synthetic wicker dining chairs in an outdoor setting" /></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="hero-code" data-hero-detail>PE / SYNTHETIC / INDONESIA</p>
        <h1><span><b data-intro>{lang === 'en' ? 'Crafted for' : 'Dirancang untuk'}</b></span><span class="accent"><b data-intro>{lang === 'en' ? 'enduring spaces' : 'ruang berkelas.'}</b></span></h1>
        <div class="hero-bottom" data-hero-detail>
          <p>{t.hero.text}</p>
          <div class="actions"><a class="button hero-primary" href={pathFor(lang,'products')}>{t.hero.primary} <ArrowUpRight size={17} /></a><a class="hero-scroll" href="#material"><ArrowDown size={18} /> {lang === 'en' ? 'See the material' : 'Lihat material'}</a></div>
        </div>
      </div>
      <div class="hero-spec" data-hero-detail><span>07</span><p>{lang === 'en' ? 'Profile families' : 'Keluarga profil'}</p></div>
    </section>

    <section class="material-intro" id="material">
      <div class="section-index" data-reveal><span>01</span><p>{lang === 'en' ? 'Built beyond standard' : 'Dibuat melampaui standar'}</p></div>
      <div data-reveal><p class="eyebrow">{t.about.eyebrow}</p><h2 class="section-title">{lang === 'en' ? <>Nature's character.<br/><i>Engineered control</i></> : <>Karakter alami.<br/><i>Kontrol terukur.</i></>}</h2></div>
      <div class="material-copy" data-reveal><p>{t.about.text}</p><a class="text-link" href={pathFor(lang,'about')}>{t.about.link} <ArrowUpRight size={16} /></a></div>
    </section>

    <section class="macro-grid">
      <div class="macro-main"><img src="/images/products/Hyacinth/abacca.jpg" alt="Macro detail of Abacca synthetic wicker weave" loading="lazy" /></div>
      <div class="macro-note" data-reveal><span>MACRO / 01</span><strong>{lang === 'en' ? 'Texture without compromise' : 'Tekstur tanpa kompromi.'}</strong><p>{lang === 'en' ? 'Consistent form. Natural depth. Built for repeatable production.' : 'Bentuk konsisten. Kedalaman alami. Dibuat untuk produksi berulang.'}</p></div>
      <div class="macro-accent"><span>100%</span><p>{lang === 'en' ? 'Recyclable PE material' : 'Material PE dapat didaur ulang'}</p></div>
    </section>

    <section class="families-section">
      <div class="families-head" data-reveal><div><p class="eyebrow">{t.product.eyebrow}</p><h2 class="section-title">{lang === 'en' ? 'Choose your profile' : 'Pilih profil Anda.'}</h2></div><p>{t.product.text}</p></div>
      <div class="family-strip">{families.map((family, i) => <a href={familyPath(lang,family.slug)} class="family-tile" data-reveal>
        <img src={family.image} alt={`${family.name} synthetic wicker`} loading="lazy" />
        <span class="family-no">{String(i+1).padStart(2,'0')}</span><div><h3>{family.name}</h3><p>{family.spec} / {family.surfaces.join(' · ')}</p></div><ArrowUpRight size={20} />
      </a>)}</div>
      <a class="all-products" href={pathFor(lang,'products')}>{lang === 'en' ? 'Explore all 88 variants' : 'Jelajahi semua 88 varian'} <ArrowUpRight size={18} /></a>
    </section>

    <section class="performance">
      <div class="performance-title" data-reveal><p class="eyebrow">PE / PERFORMANCE</p><h2>{lang === 'en' ? <>Enduring quality,<br/><mark>considered beauty</mark></> : <>Kualitas tahan lama,<br/><mark>keindahan terukur.</mark></>}</h2></div>
      <div class="benefit-list">{t.benefits.map((item, i) => { const Icon = benefitIcons[i]; return <div data-reveal><Icon size={26} stroke-width={1.5} /><span>{String(i+1).padStart(2,'0')}</span><strong>{item}</strong></div> })}</div>
    </section>

    <section class="trust-section">
      <div class="trust-head" data-reveal>
        <p class="eyebrow">{t.trust.eyebrow}</p>
        <h2 class="section-title">{t.trust.title}</h2>
        <p class="lede">{t.trust.text}</p>
      </div>
      <div class="trust-grid">
        {t.trust.stats.map((stat, i) => <div class="trust-card" data-reveal>
          <span class="trust-value">{stat.value}</span>
          <strong>{stat.label}</strong>
          <p>{stat.desc}</p>
        </div>)}
      </div>
    </section>

    <ContactBlock lang={lang} whatsapp={whatsapp} />
  </>}

  {page === 'about' && <>
    <section class="about-simple-hero">
      <div class="about-simple-copy">
        <p class="eyebrow" data-hero-detail>{t.aboutPage.eyebrow}</p>
        <h1><span><b data-intro>{lang === 'en' ? 'Made beyond' : 'Dibuat melampaui'}</b></span><span class="outline"><b data-intro>{lang === 'en' ? 'standard quality' : 'standar kualitas.'}</b></span></h1>
        <p data-hero-detail>{t.aboutPage.title} {t.aboutPage.lead}</p>
      </div>
      <div class="about-simple-photo" data-hero-media><img src="/images/editorial/compro-outdoor-lounge.jpg" alt="SUNRISE synthetic wicker lounge furniture outdoors" /><span class="photo-credit">©Skyline</span></div>
    </section>

    <section class="about-numbers">
      <p class="eyebrow" data-reveal>{t.keyNumbers.eyebrow}</p>
      <h2 data-reveal>{t.keyNumbers.title}</h2>
      <div class="numbers-grid">
        {t.keyNumbers.items.map((item) => <div class="number-card" data-reveal>
          <span>{item.value}</span>
          <p>{item.label}</p>
        </div>)}
      </div>
    </section>

    <section class="about-overview">
      <div data-reveal><p class="eyebrow">{lang === 'en' ? 'About the product' : 'Tentang produk'}</p><h2>{t.aboutPage.responsible}</h2></div>
      <div data-reveal>
        <p>{t.aboutPage.responsibleText}</p>
      </div>
    </section>

    <section class="about-production">
      <div class="about-production-photo"><img src="/images/products/Flat Oval/DSC_9455 FO 7MM IRR - BAVARIAN.JPG" alt="Bavarian flat oval SUNRISE synthetic wicker" loading="lazy" /></div>
      <div data-reveal><p class="eyebrow">{lang === 'en' ? 'How it is made' : 'Cara produk dibuat'}</p><h2>{t.aboutPage.tech}</h2><p>{t.aboutPage.techText}</p></div>
    </section>

    <section class="about-benefits"><p class="eyebrow">{lang === 'en' ? 'Product advantages' : 'Keunggulan produk'}</p><div>{t.benefits.map((item,i) => { const Icon = benefitIcons[i]; return <article data-reveal><span>0{i+1}</span><Icon aria-hidden="true" size={34} stroke-width={1.5} /><strong>{item}</strong></article> })}</div></section>
    <ContactBlock lang={lang} whatsapp={whatsapp} />
  </>}

  {page === 'products' && <>
    <section class="products-hero">
      <div><p class="eyebrow" data-hero-detail>{t.product.eyebrow}</p><h1><span><b data-intro>{lang === 'en' ? 'A considered' : 'Koleksi material'}</b></span><span class="outline"><b data-intro>{lang === 'en' ? 'material collection' : 'yang terkurasi.'}</b></span></h1></div>
      <div class="products-hero-side" data-hero-detail><p>{lang === 'en' ? 'Seven profile families. An extensive palette of colors, dimensions, and tactile finishes.' : 'Tujuh keluarga profil. Palet luas berisi warna, dimensi, dan hasil akhir bertekstur.'}</p></div>
    </section>
    <section class="surface-guide" data-reveal>
      <div class="surface-guide-intro"><p class="eyebrow">{lang === 'en' ? 'Surface options' : 'Pilihan permukaan'}</p><h2>{lang === 'en' ? 'Understanding our finish codes' : 'Memahami kode hasil akhir.'}</h2><p>{lang === 'en' ? 'These abbreviations describe the visible surface character of each wicker profile. Available options vary by product family.' : 'Singkatan ini menjelaskan karakter permukaan yang terlihat pada setiap profil rotan. Pilihan yang tersedia berbeda pada setiap keluarga produk.'}</p></div>
      <div class="surface-terms" aria-label={lang === 'en' ? 'Surface code definitions' : 'Definisi kode permukaan'}>{surfaceOptions.map(([code, name, description]) => <div class="surface-term" tabindex="0" aria-describedby={`surface-${code}`}>
        <span>{code}</span>
        <div class="surface-popover" id={`surface-${code}`} role="tooltip"><strong>{name}</strong><p>{lang === 'en' ? ({ RR: 'A regular ribbed surface.', FR: 'A finer ribbed surface.', IRR: 'An irregular ribbed surface.', TX: 'A visibly textured surface.', SM: 'A smooth surface finish.', HL: 'A fine hairline or brushed appearance.', EBS: 'A raised embossed surface pattern.' } as Record<string,string>)[code] : description}</p></div>
      </div>)}</div>
    </section>
    <section class="collection-index">
      <div class="collection-heading" data-reveal><span>PROFILE INDEX / 01—07</span><p>{lang === 'en' ? 'Start with shape. Select a family to inspect every color and surface.' : 'Mulai dari bentuk. Pilih keluarga untuk melihat setiap warna dan permukaan.'}</p></div>
      {families.map((family,i) => { const familyProducts = products.filter((p) => p.family === family.name); const previews = familyProducts.slice(0,3); return <a class="collection-line" href={familyPath(lang,family.slug)} data-reveal>
        <span>{String(i+1).padStart(2,'0')}</span><div class="collection-previews">{previews.map((product) => <figure><img src={product.image} alt={`${product.color} ${family.name}`} loading="lazy" /><figcaption>{product.color}</figcaption></figure>)}</div><div class="collection-name"><h2>{family.name}</h2><p>{family.detail}</p></div><strong>{familyProducts.length} {lang === 'en' ? 'colors' : 'warna'}</strong><ArrowUpRight size={22} />
      </a>})}
    </section>
    <ContactBlock lang={lang} whatsapp={whatsapp} />
  </>}

  {page === 'contact' && <>
    <section class="contact-hero">
      <div><p class="eyebrow" data-hero-detail>{t.contact.eyebrow}</p><h1><span><b data-intro>{lang === 'en' ? 'Begin your' : 'Mulai proyek'}</b></span><span class="orange-text"><b data-intro>{lang === 'en' ? 'next collection' : 'Anda berikutnya.'}</b></span></h1></div>
      <div class="contact-photo" data-hero-media><img src="/images/products/Hyacinth/stone black.jpg" alt="Stone black SUNRISE wicker texture" /></div>
      <p data-hero-detail>{t.contact.text}</p>
    </section>

    <section class="contact-directory">
      <a href={whatsappAlt} data-reveal><span>01 / WhatsApp</span><strong>+62 811 308 731</strong><ArrowUpRight size={28} /></a>
      <a href={whatsapp} data-reveal><span>02 / WhatsApp</span><strong>+62 811 327 030</strong><ArrowUpRight size={28} /></a>
      <a href="mailto:sunrisewicker@gmail.com" data-reveal><span>03 / Email</span><strong>sunrisewicker@gmail.com</strong><ArrowUpRight size={28} /></a>
    </section>

    <section class="contact-form-section">
      <div class="form-intro" data-reveal>
        <p class="eyebrow">{t.form.formTitle}</p>
        <h2>{lang === 'en' ? <>Send us a<br/><i>message</i></> : <>Kirimkan<br/><i>pesan Anda.</i></>}</h2>
        <p>{t.form.formDesc}</p>
      </div>
      <form class="inquiry-form" data-reveal data-form action="#" method="POST">
        <div class="form-row">
          <div class="form-field">
            <label for="contact-name">{t.form.name}</label>
            <input type="text" id="contact-name" name="name" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="contact-email">{t.form.email}</label>
            <input type="email" id="contact-email" name="email" required autocomplete="email" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="contact-company">{t.form.company}</label>
            <input type="text" id="contact-company" name="company" autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="contact-product">{t.form.product}</label>
            <select id="contact-product" name="product">
              <option value="" disabled selected>{t.form.selectPlaceholder}</option>
              {t.form.productOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
        </div>
        <div class="form-field full">
          <label for="contact-message">{t.form.message}</label>
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="button primary form-submit">{t.form.submit} <Send size={16} /></button>
      </form>
    </section>

  </>}
</BaseLayout>

<script>
  // Contact form — build mailto link and open
  const form = document.querySelector('[data-form]') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') || '';
    const email = data.get('email') || '';
    const company = data.get('company') || '';
    const product = data.get('product') || '';
    const message = data.get('message') || '';
    const subject = `Inquiry from ${name}${company ? ` — ${company}` : ''}`;
    const body = `Name: ${name}\nEmail: ${email}\nCompany: ${company}\nProduct Interest: ${product}\n\n${message}`;
    const mailto = `mailto:sunrisewicker@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>

<style>
  .home-hero { position: relative; min-height: 100svh; color: white; background: var(--ink); overflow: hidden }
  .hero-media, .hero-shade { position: absolute; inset: 0 }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center 57%; transform: scale(1.02) }
  .hero-shade { background: linear-gradient(90deg, rgba(7,24,42,.92) 0%, rgba(7,24,42,.6) 46%, rgba(7,24,42,.16) 78%), linear-gradient(0deg, rgba(7,24,42,.72), transparent 50%) }
  .hero-content { position: relative; z-index: 2; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: 130px var(--pad) 68px }
  .hero-code { margin: 0 0 1.2rem; font: .65rem var(--mono); letter-spacing: .15em }
  .hero-content h1 { max-width: 1050px; margin: 0; font: 600 clamp(4.8rem,10vw,10rem)/.78 var(--display); letter-spacing: -.045em }
  .hero-content h1 span, .editorial-copy h1 span, .products-hero h1 span, .contact-hero h1 span, .about-simple-copy h1 span { display: block; padding-block: .14em .2em; margin-block: -.14em -.2em; overflow: hidden }
  .hero-content h1 b, .editorial-copy h1 b, .products-hero h1 b, .contact-hero h1 b { display: block; font: inherit }
  .hero-content h1 .accent { color: #ead7af; font-style: italic }
  .hero-bottom { display: grid; grid-template-columns: minmax(280px,450px) 1fr; align-items: end; gap: 4rem; margin-top: 2.5rem }
  .hero-bottom p { margin: 0; color: #d5dce1; line-height: 1.6 }
  .hero-bottom .actions { justify-content: flex-start; align-items: center }
  .hero-primary { color: var(--ink); background: #ead7af; border-color: #ead7af }
  .hero-scroll { display: inline-flex; gap: .5rem; align-items: center; font-size: .75rem }
  .hero-spec { position: absolute; z-index: 3; right: var(--pad); bottom: 66px; width: 150px; padding-top: .9rem; border-top: 1px solid white }
  .hero-spec span { color: var(--yellow); font: 700 2.5rem var(--display) }
  .hero-spec p { margin: .1rem 0; font: .6rem var(--mono); text-transform: uppercase }
  .material-intro { display: grid; grid-template-columns: .42fr 1.1fr .58fr; gap: clamp(2rem,5vw,6rem); align-items: end; padding: clamp(7rem,12vw,12rem) var(--pad) }
  .section-index { align-self: start; display: flex; gap: 1rem; align-items: center; font: .62rem var(--mono); text-transform: uppercase }
  .section-index span { display: grid; place-items: center; width: 42px; height: 42px; color: var(--ink); background: var(--yellow) }
  .section-title i { color: var(--orange); font-style: normal }
  .material-copy p { color: var(--muted); line-height: 1.7; margin: 0 0 2rem }
  .macro-grid { display: grid; grid-template-columns: 1.35fr .65fr; grid-template-rows: 1fr auto; min-height: 760px; color: white; background: var(--blue) }
  .macro-main { grid-row: span 2; min-height: 700px }
  .macro-main img { width: 100%; height: 100%; object-fit: cover }
  .macro-note { padding: clamp(3rem,6vw,6rem); align-self: center }
  .macro-note span { font: .65rem var(--mono); color: var(--yellow) }
  .macro-note strong { display: block; margin: 2rem 0; font: 700 clamp(2.5rem,4vw,4.4rem)/.9 var(--display); text-transform: uppercase }
  .macro-note p { color: #bdcad6; line-height: 1.6 }
  .macro-accent { display: flex; align-items: end; justify-content: space-between; padding: 2rem 3rem; color: white; background: #1a3d59; border-top: 1px solid rgba(255,255,255,.22) }
  .macro-accent span { color: var(--yellow); font: 600 clamp(4rem,7vw,7rem)/.7 var(--display) }
  .macro-accent p { max-width: 120px; margin: 0; font-size: .7rem; font-weight: 600; text-transform: uppercase }
  .families-section { padding: clamp(7rem,11vw,11rem) var(--pad) }
  .families-head { display: grid; grid-template-columns: 1fr .42fr; gap: 4rem; align-items: end; margin-bottom: 4rem }
  .families-head > p { color: var(--muted); line-height: 1.7 }
  .family-strip { display: grid; grid-template-columns: repeat(7,1fr); min-height: 500px; border-left: 1px solid var(--line) }
  .family-tile { position: relative; display: flex; align-items: end; margin-right: .7rem; overflow: hidden; border: 1px solid rgba(255,255,255,.15); border-radius: 26px 26px 8px 26px; background: var(--ink) }
  .family-tile:nth-child(even) { margin-top: 26px; margin-bottom: -26px; border-radius: 8px 26px 26px 26px }
  .family-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(.25) brightness(.64); transition: transform .6s, filter .4s }
  .family-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(7,24,42,.9), transparent 58%) }
  .family-tile:hover img { transform: scale(1.05); filter: none }
  .family-no { position: absolute; z-index: 2; top: 1rem; left: 1rem; color: var(--yellow); font: .7rem var(--mono) }
  .family-tile div { position: relative; z-index: 2; padding: 1.2rem; color: white }
  .family-tile h3 { margin: 0; font: 700 clamp(1.2rem,1.7vw,1.9rem)/.9 var(--display); text-transform: uppercase }
  .family-tile p { margin: .5rem 0 0; color: #bec9d2; font: .55rem var(--mono); line-height: 1.5 }
  .family-tile :global(svg) { position: absolute; z-index: 2; top: 1rem; right: 1rem; color: white; opacity: 0; transition: opacity .3s }
  .family-tile:hover :global(svg) { opacity: 1 }
  .all-products { display: flex; justify-content: space-between; padding: 1.3rem 0; border-bottom: 1px solid var(--ink); font-size: .8rem; font-weight: 600; text-transform: uppercase }
  .performance { display: grid; grid-template-columns: 1fr .7fr; gap: 6rem; padding: clamp(7rem,11vw,11rem) var(--pad); color: white; background: var(--ink) }
  .performance-title h2 { margin: 0; font: 600 clamp(4rem,7vw,7rem)/.85 var(--display); letter-spacing: -.04em }
  .performance-title h2 mark { font-style: italic }
  .performance-title mark { color: var(--yellow); background: none }
  .benefit-list { border-top: 1px solid rgba(255,255,255,.25) }
  .benefit-list div { display: grid; grid-template-columns: 35px 38px 1fr; gap: 1rem; align-items: center; padding: 1.7rem 0; border-bottom: 1px solid rgba(255,255,255,.25) }
  .benefit-list span { color: var(--orange); font: .65rem var(--mono) }
  .benefit-list strong { font: 600 clamp(1.3rem,2vw,2rem) var(--display); text-transform: uppercase }

  /* ── TRUST SIGNALS ── */
  .trust-section { padding: clamp(7rem,11vw,11rem) var(--pad); background: var(--white); border-top: 1px solid var(--line) }
  .trust-head { max-width: 680px; margin-bottom: 4rem }
  .trust-head .section-title { margin-bottom: 1.5rem }
  .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 }
  .trust-card { position: relative; padding: clamp(2rem,3vw,3rem); border: 1px solid var(--line); border-right: 0; transition: background .3s }
  .trust-card:last-child { border-right: 1px solid var(--line) }
  .trust-card:hover { background: var(--paper) }
  .trust-value { display: block; margin-bottom: 1rem; color: var(--orange); font: 700 clamp(3rem,5vw,4.5rem)/.85 var(--display); letter-spacing: -.03em }
  .trust-card strong { display: block; margin-bottom: .5rem; font: 600 1.05rem var(--display); text-transform: uppercase }
  .trust-card p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.5 }

  .products-hero h1, .contact-hero h1 { margin: 0; font: 600 clamp(4.8rem,9vw,9rem)/.8 var(--display); letter-spacing: -.04em }
  .contact-hero h1 { line-height: .94 }
  .outline { color: #d8bd88; font-style: italic }
  .about-simple-hero { min-height: 88svh; display: grid; grid-template-columns: 1fr .72fr; gap: clamp(3rem,7vw,8rem); align-items: center; padding: 130px var(--pad) 70px; color: white; background: var(--blue) }
  .about-simple-copy h1 { margin: 0; font: 600 clamp(4.6rem,8vw,8rem)/.82 var(--display); letter-spacing: -.04em }
  .about-simple-copy h1 b { display: block; font: inherit }
  .about-simple-copy > p:last-child { max-width: 650px; margin: 2.5rem 0 0; color: #d4dde5; line-height: 1.75 }
